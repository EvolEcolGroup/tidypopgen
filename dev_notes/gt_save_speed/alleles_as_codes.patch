@@ -147,10 +150,58 @@ fbm_file_names <- function(x) {
 
 # save a gen_tibble to its .gt file with saveRDS(), compressed with gzip at
 # level 1: compared with the default level of saveRDS() (6), this halves the
-# time to save millions of loci, for a file about 20% larger, and the file
-# is read by readRDS() as any .rds file
+# time to save millions of loci, for a file about 20% larger. The alleles of
+# the loci table are saved as codes (see compact_loci_alleles()), which
+# gt_load() turns back into strings (restore_loci_alleles())
 save_gt_file <- function(x, file_name) {
+  x <- compact_loci_alleles(x)
   file_con <- gzfile(file_name, open = "wb", compression = 1)
   on.exit(close(file_con))
   saveRDS(x, file_con)
 }
+
+# Replace the allele columns of the loci table of a gen_tibble (to be saved)
+# by codes: saving a character vector (and loading it) costs a call for each
+# element, which took two thirds of the time of saving and of loading a .gt
+# file with tens of millions of loci. The codes (raw, or integer with more
+# than 255 distinct alleles) and the distinct alleles are kept in the
+# attribute "compact_alleles" of the loci table, with the names of its
+# columns (to restore their order), and the allele columns are removed (so
+# that older versions of tidypopgen, which do not restore them, stop with an
+# error rather than use wrong alleles). The gen_tibble in memory is not
+# changed (the loci table of the copy saved shares its other columns).
+compact_loci_alleles <- function(x) {
+  loci <- attr(x$genotypes, "loci")
+  allele_cols <- c("allele_ref", "allele_alt")
+  if (!all(allele_cols %in% names(loci)) ||
+        !is.character(loci$allele_ref) || !is.character(loci$allele_alt)) {
+    return(x)
+  }
+  codes <- encode_alleles_cpp(loci$allele_ref, loci$allele_alt)
+  compact <- list(
+    columns = names(loci),
+    allele_ref = codes$ref,
+    allele_alt = codes$alt,
+    levels = codes$levels
+  )
+  loci <- loci[setdiff(names(loci), allele_cols)]
+  attr(loci, "compact_alleles") <- compact
+  attr(x$genotypes, "loci") <- loci
+  x
+}
+
+# Restore the allele columns of the loci table of a gen_tibble read from a
+# .gt file (saved by compact_loci_alleles()); gen_tibbles saved by older
+# versions are returned unchanged
+restore_loci_alleles <- function(x) {
+  loci <- attr(x$genotypes, "loci")
+  compact <- attr(loci, "compact_alleles")
+  if (is.null(compact)) {
+    return(x)
+  }
+  attr(loci, "compact_alleles") <- NULL
+  loci$allele_ref <- decode_alleles_cpp(compact$allele_ref, compact$levels)
+  loci$allele_alt <- decode_alleles_cpp(compact$allele_alt, compact$levels)
+  attr(x$genotypes, "loci") <- loci[compact$columns]
+  x
+}
