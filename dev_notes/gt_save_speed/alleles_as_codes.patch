 })
 
+test_that("the alleles are saved as codes, and load back identical", {
+  # alleles with NAs, and more than 255 distinct alleles (integer codes)
+  n_loci <- 300
+  many_loci <- data.frame(
+    name = paste0("rs", seq_len(n_loci)),
+    chromosome = "chr1",
+    position = seq_len(n_loci),
+    genetic_dist = 0,
+    allele_ref = strrep("A", seq_len(n_loci)),
+    allele_alt = c(NA, rep(c("C", "G"), length.out = n_loci - 1))
+  )
+  many_gt <- gen_tibble(
+    x = matrix(rep(c(0, 1, 2), length.out = 2 * n_loci), nrow = 2),
+    loci = many_loci,
+    indiv_meta = data.frame(id = c("a", "b"), population = "pop1"),
+    valid_alleles = unique(c(many_loci$allele_ref, "C", "G")),
+    quiet = TRUE
+  )
+  for (x_gt in list(test_gt, many_gt)) {
+    loci_before <- show_loci(x_gt)
+    gt_file <- paste0(tempfile(), ".gt")
+    gt_save(x_gt, file_name = gt_file, quiet = TRUE)
+    # the file holds the codes, not the allele columns
+    saved_loci <- attr(readRDS(gt_file)$genotypes, "loci")
+    expect_false(any(c("allele_ref", "allele_alt") %in% names(saved_loci)))
+    expect_false(is.null(attr(saved_loci, "compact_alleles")))
+    # the gen_tibble in memory is unchanged, and loads back identical
+    expect_identical(show_loci(x_gt), loci_before)
+    expect_identical(show_loci(gt_load(gt_file)), loci_before)
+  }
+  # (with more than 255 distinct alleles, the codes are integers)
+  expect_type(attr(saved_loci, "compact_alleles")$allele_ref, "integer")
+})
+
 # this also tests show_genotypes and show_loci
 test_that("save and load gt", {
   expect_true(inherits(test_gt, "gen_tbl"))
