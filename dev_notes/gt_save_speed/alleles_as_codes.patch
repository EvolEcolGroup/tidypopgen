diff --git a/src/strings_in_cpp.cpp b/src/strings_in_cpp.cpp
index f720fd88..efbcac9a 100644
--- a/src/strings_in_cpp.cpp
+++ b/src/strings_in_cpp.cpp
@@ -193,3 +193,122 @@ double any_duplicated_strings_cpp(const CharacterVector& x) {
 }
 
 /******************************************************************************/
+
+/******************************************************************************/
+// The alleles of the loci table in a compact form, to save the .gt file (see
+// save_gt_file() and restore_loci_alleles()).
+//
+// Saving and loading a character vector costs a call for each element (and
+// loading creates or finds the CHARSXP of each, in the global cache of
+// strings), which made two thirds of the time of saving and loading a .gt
+// file with tens of millions of loci. The alleles take few distinct values, so
+// they are saved as a code per locus (raw, or integer with more than 255
+// distinct alleles) into a vector of their distinct strings.
+//
+// The distinct alleles are the distinct CHARSXPs (found by their address in a
+// hash table, as in any_duplicated_strings_cpp()): the same text in two
+// encodings gives two levels, so decoding gives back the very same CHARSXPs.
+// NA is a level like any other.
+
+// [[Rcpp::export]]
+List encode_alleles_cpp(const CharacterVector& ref,
+                        const CharacterVector& alt) {
+  const R_xlen_t n = ref.size();
+  if (alt.size() != n) {
+    stop("allele_ref and allele_alt should have the same length");
+  }
+  const SEXP* columns[2] = {STRING_PTR_RO(ref), STRING_PTR_RO(alt)};
+  // the codes (1-based) of each column, and the distinct CHARSXPs
+  std::vector<int> codes[2];
+  codes[0].resize(n);
+  codes[1].resize(n);
+  std::vector<SEXP> levels;
+  // a hash table of 2^k slots, at most half full, holding the code of each
+  // distinct CHARSXP (0 for an empty slot), grown as needed
+  int k = 6;
+  std::vector<uint32_t> slots((size_t) 1 << k, 0);
+  for (int c = 0; c < 2; c++) {
+    const SEXP* p = columns[c];
+    int* out = codes[c].data();
+    SEXP last = NULL;  // (consecutive alleles are often the same)
+    int last_code = 0;
+    for (R_xlen_t i = 0; i < n; i++) {
+      SEXP s = p[i];
+      if (s == last) {
+        out[i] = last_code;
+        continue;
+      }
+      uint64_t mask = ((uint64_t) 1 << k) - 1;
+      uint64_t h = string_address_hash(s) >> (64 - k);
+      while (slots[h] != 0 && levels[slots[h] - 1] != s) {
+        h = (h + 1) & mask;
+      }
+      if (slots[h] == 0) {
+        // a new level
+        levels.push_back(s);
+        slots[h] = (uint32_t) levels.size();
+        if (levels.size() * 2 > slots.size()) {
+          // grow the table, and insert the levels again
+          k++;
+          std::vector<uint32_t>((size_t) 1 << k, 0).swap(slots);
+          mask = ((uint64_t) 1 << k) - 1;
+          for (size_t l = 0; l < levels.size(); l++) {
+            uint64_t g = string_address_hash(levels[l]) >> (64 - k);
+            while (slots[g] != 0) g = (g + 1) & mask;
+            slots[g] = (uint32_t)(l + 1);
+          }
+          h = string_address_hash(s) >> (64 - k);
+          while (levels[slots[h] - 1] != s) h = (h + 1) & mask;
+        }
+      }
+      last = s;
+      last_code = (int) slots[h];
+      out[i] = last_code;
+    }
+  }
+  CharacterVector res_levels(levels.size());
+  for (size_t l = 0; l < levels.size(); l++) {
+    SET_STRING_ELT(res_levels, l, levels[l]);
+  }
+  // codes as raw vectors if they fit in a byte (a quarter of the size)
+  List res(2);
+  for (int c = 0; c < 2; c++) {
+    if (levels.size() <= 255) {
+      RawVector v(n);
+      for (R_xlen_t i = 0; i < n; i++) v[i] = (Rbyte) codes[c][i];
+      res[c] = v;
+    } else {
+      IntegerVector v(codes[c].begin(), codes[c].end());
+      res[c] = v;
+    }
+    std::vector<int>().swap(codes[c]);
+  }
+  return List::create(_["ref"] = res[0], _["alt"] = res[1],
+                      _["levels"] = res_levels);
+}
+
+// The alleles from their codes (raw or integer, 1-based) and levels, as
+// returned by encode_alleles_cpp()
+// [[Rcpp::export]]
+CharacterVector decode_alleles_cpp(SEXP codes, const CharacterVector& levels) {
+  const R_xlen_t n = Rf_xlength(codes);
+  const R_xlen_t n_levels = levels.size();
+  CharacterVector res(n);
+  const SEXP* lev = STRING_PTR_RO(levels);
+  if (TYPEOF(codes) == RAWSXP) {
+    const Rbyte* p = RAW(codes);
+    for (R_xlen_t i = 0; i < n; i++) {
+      if (p[i] == 0 || p[i] > n_levels) stop("invalid allele code");
+      SET_STRING_ELT(res, i, lev[p[i] - 1]);
+    }
+  } else if (TYPEOF(codes) == INTSXP) {
+    const int* p = INTEGER(codes);
+    for (R_xlen_t i = 0; i < n; i++) {
+      if (p[i] < 1 || p[i] > n_levels) stop("invalid allele code");
+      SET_STRING_ELT(res, i, lev[p[i] - 1]);
+    }
+  } else {
+    stop("allele codes should be raw or integer");
+  }
+  return res;
+}
